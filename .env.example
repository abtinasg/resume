# OpenAI API Key for resume analysis
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Model Configuration
# Default: gpt-4o (recommended for quality)
# Alternative: gpt-4o-mini (for cost efficiency)
OPENAI_MODEL=gpt-4o

# Hybrid Mode Configuration
# Controls whether AI layer is mandatory for resume scoring
# - true (default): AI layer is required - system fails if AI is unavailable
# - false: Local scoring only - AI layer is skipped (for testing/development)
# When enabled, both local scoring AND AI validation must succeed
HYBRID_MODE=true

# Contact Form Email Configuration
# SECURITY NOTE: Use an app-specific password, NOT your account password.
# For Gmail: https://support.google.com/accounts/answer/185833
# TODO: Migrate to OAuth2 or email API service (SendGrid/Resend) for production
CONTACT_EMAIL=youremail@gmail.com
CONTACT_EMAIL_PASSWORD=<app-specific-password>

# Database Configuration
# PostgreSQL connection string for user authentication
# Format: postgresql://username:password@host:port/database?schema=public
DATABASE_URL=postgresql://postgres:password@localhost:5432/resumeiq?schema=public

# JWT Authentication Secret (required)
# Generate and set a strong, random string (e.g., using: openssl rand -base64 32)
# The application will refuse to generate or verify tokens if this is not configured
JWT_SECRET= # set to a secure random value before running the app

# NextAuth Secret (required)
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# CORS Configuration
# Set to your production domain. Defaults to https://resumeiq.com
ALLOWED_ORIGIN=http://localhost:3000

# Admin Configuration
# Comma-separated list of admin email addresses
ADMIN_EMAILS=admin@resumeiq.com
